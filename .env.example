# Use a path on the frontend origin in production, or an absolute Treetop URL
# when the server is configured for browser cross-origin requests.
VITE_TREETOP_API_URL=/treetop-api

# Development-only Vite reverse-proxy target.
VITE_TREETOP_PROXY_TARGET=http://127.0.0.1:9999

# Optional named connections shown in the server switcher. This JSON is public
# frontend configuration; do not put credentials or upload tokens in it.
# VITE_TREETOP_SERVER_PROFILES={"defaultServer":"test","servers":[{"id":"test","name":"Test","url":"/treetop-test"},{"id":"production","name":"Production","url":"/treetop-production"}]}

# Optional development proxy map for the same-origin paths above.
# VITE_TREETOP_PROXY_TARGETS={"/treetop-test":"http://127.0.0.1:9999","/treetop-production":"http://127.0.0.1:10000"}
