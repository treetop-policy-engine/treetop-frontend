# Public browser configuration generated when the container starts.
TREETOP_API_URL=/treetop-api
# TREETOP_ACTIVE_SERVER=test
# TREETOP_SERVER_PROFILES={"defaultServer":"test","servers":[{"id":"test","name":"Test","url":"/treetop-api"}]}

# Optional same-origin reverse proxy. Use a container/service name reachable on
# the same Docker or Podman network, not localhost (which means this container).
TREETOP_PROXY_TARGET=http://treetop-rest:9999
# TREETOP_PROXY_TARGETS={"/treetop-test":"http://treetop-test:9999","/treetop-production":"http://treetop-production:9999"}

# Optional server-side proxy credentials. These are never written to config.js.
# TREETOP_PROXY_ACCESS_TOKEN=deployment-default-token
# TREETOP_PROXY_ACCESS_TOKENS={"/treetop-production":"production-deployment-token"}
